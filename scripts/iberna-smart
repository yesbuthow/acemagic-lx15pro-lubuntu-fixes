#!/bin/bash

# Stato del pannello interno prima dell'ibernazione.
if xrandr --query | grep -qE '^eDP connected.*[0-9]+x[0-9]+\+[0-9]+\+[0-9]+'; then
    EDP_WAS_ON=1
else
    EDP_WAS_ON=0
fi

logger -t iberna-smart "Prima dell'ibernazione: eDP attivo=$EDP_WAS_ON"

# Blocca esplicitamente la sessione.
# Se il lock fallisce, per sicurezza NON iberniamo.
LOCK_LOG="$(mktemp)"

# Avviamo il watcher PRIMA di richiedere il lock, così non perdiamo
# l'evento LOCK emesso da XScreenSaver.
timeout 3s xscreensaver-command -watch >"$LOCK_LOG" 2>&1 &
WATCH_PID=$!

sleep 0.1

if ! xscreensaver-command -lock >/dev/null 2>&1; then
    kill "$WATCH_PID" 2>/dev/null || true
    wait "$WATCH_PID" 2>/dev/null || true
    rm -f "$LOCK_LOG"

    logger -t iberna-smart "ERRORE: impossibile richiedere il lock XScreenSaver; ibernazione annullata"
    exit 1
fi

LOCK_SEEN=0

for i in {1..40}; do
    if grep -q '^LOCK ' "$LOCK_LOG" 2>/dev/null; then
        LOCK_SEEN=1
        break
    fi
    sleep 0.05
done

kill "$WATCH_PID" 2>/dev/null || true
wait "$WATCH_PID" 2>/dev/null || true
rm -f "$LOCK_LOG"

if [ "$LOCK_SEEN" -ne 1 ]; then
    logger -t iberna-smart "ERRORE: XScreenSaver non ha confermato LOCK; ibernazione annullata"
    exit 1
fi

logger -t iberna-smart "XScreenSaver LOCK confermato"

/usr/bin/systemctl hibernate
RET=$?

if [ "$RET" -ne 0 ]; then
    logger -t iberna-smart "Ibernazione fallita: codice $RET"
    exit "$RET"
fi

#
# systemctl può restituire il controllo PRIMA che l'ibernazione
# sia realmente iniziata. Aspettiamo quindi che il servizio
# systemd-hibernate diventi attivo.
#

# Piccolo margine perché systemd avvii realmente l'ibernazione.
# Quando il sistema viene congelato, anche questo sleep viene congelato.
sleep 0.75

logger -t iberna-smart "Resume reale: avvio ripristino display"

# Non forziamo ancora DPMS ON: prima lasciamo stabilizzare AMDGPU
# e completiamo la gestione dei display. Il wake avverrà alla fine.

# Invece di aspettare 1 secondo fisso, attendiamo XRandR.
# Massimo ~1 secondo, ma normalmente usciamo quasi subito.
XRANDR=""

for i in {1..20}; do
    XRANDR="$(xrandr --query 2>/dev/null)" && [ -n "$XRANDR" ] && break
    sleep 0.05
done

if printf '%s\n' "$XRANDR" | \
   grep -qE '^(DisplayPort|HDMI)[^ ]* connected.*[0-9]+x[0-9]+\+[0-9]+\+[0-9]+'; then
    EXTERNAL_ACTIVE=1
else
    EXTERNAL_ACTIVE=0
fi

logger -t iberna-smart "Dopo resume: monitor esterno attivo=$EXTERNAL_ACTIVE"

if [ "$EXTERNAL_ACTIVE" -eq 0 ]; then

    if [ "$EDP_WAS_ON" -eq 1 ]; then

        # Laptop-only: eDP era già attivo prima dell'ibernazione.
        # Non forziamo OFF/ON: AMDGPU ha appena ripristinato il link
        # e un nuovo link-training può fallire durante il recovery DMCUB.
        logger -t iberna-smart "Laptop-only: eDP era già attivo, non modifico il link"

    else

        # Prima dell'ibernazione eDP era spento (tipicamente uso con
        # monitor esterno), ma ora non c'è più alcun monitor esterno.
        # In questo caso dobbiamo necessariamente riattivare il pannello.
        logger -t iberna-smart "Monitor esterno assente ed eDP prima spento: attivo eDP"

        xrandr --output eDP --off
        sleep 0.2
        xrandr --output eDP --auto || true

    fi

elif [ "$EDP_WAS_ON" -eq 1 ]; then

    # eDP era acceso prima dell'ibernazione.
    logger -t iberna-smart "eDP era attivo: reset rapido OFF/ON"

    xrandr --output eDP --off
    sleep 0.2
    xrandr --output eDP --auto

else

    # Monitor esterno ancora presente ed eDP volutamente spento.
    logger -t iberna-smart "Monitor esterno presente: mantengo eDP spento"

    xrandr --output eDP --off
fi

# Secondo wake DPMS dopo l'eventuale riconfigurazione XRandR.
xset s reset >/dev/null 2>&1 || true
xset dpms force on >/dev/null 2>&1 || true

logger -t iberna-smart "Display ripristinati dopo resume"
